# ================================================
# NEXO - Variables de entorno
# Copia este archivo como .env y llena los valores
# ================================================

# Servidor
PORT=3000
NODE_ENV=development

# JWT - Cambia este valor por una cadena secreta larga
JWT_SECRET=nexo_super_secret_key_cambiar_en_produccion_2024
JWT_EXPIRES_IN=7d

# Supabase (obtenlos en supabase.com -> tu proyecto -> Settings -> API)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu_service_role_key_aqui

# Almacenamiento de fotos (Supabase Storage)
SUPABASE_STORAGE_BUCKET=nexo-photos

# Email (para verificación de cuenta)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_contrasena_de_aplicacion

# Google Maps (para geolocalización)
GOOGLE_MAPS_API_KEY=tu_api_key_de_google_maps

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:8081

# ── Mejoras v2.0 ────────────────────────────────────────────────
# Mejora 1: AWS Rekognition (verificación facial)
AWS_ACCESS_KEY_ID=tu_access_key
AWS_SECRET_ACCESS_KEY=tu_secret_key
AWS_REGION=us-east-1

# Mejora 4: Google Translate API
GOOGLE_TRANSLATE_KEY=tu_api_key_de_google_translate

# ================================================
# INSTRUCCIONES:
# 1. Ve a supabase.com y crea una cuenta gratuita
# 2. Crea un nuevo proyecto llamado "nexo"
# 3. Ve a Settings > API y copia las claves
# 4. Pega los valores arriba y guarda como .env
# 5. Las claves de AWS y Google son opcionales en desarrollo
# ================================================

# Función nueva 1: Videollamada (Agora.io)
# Registro gratis en: https://console.agora.io
# Primeros 10,000 minutos/mes son GRATIS
AGORA_APP_ID=tu_agora_app_id
AGORA_APP_CERTIFICATE=tu_agora_certificate
